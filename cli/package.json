    "build": "node scripts/build.mjs",
    "dev": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@usualmail/core": "file:../core",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
