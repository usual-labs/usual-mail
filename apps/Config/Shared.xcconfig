// Build settings shared by every configuration of both app targets: UsualMail (the Mac app) uses them as they are,
// UsualMailPhone (the iPhone app) with Phone.xcconfig over them.
// Your signing team (and a bundle prefix of your own, for a fork) go in Local.xcconfig, which is
// gitignored; see Local.xcconfig.example. Unsigned builds need neither.

PRODUCT_NAME = UsualMail
INFOPLIST_KEY_CFBundleDisplayName = Usual Mail
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

BUNDLE_ID_PREFIX = labs.usual
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).UsualMail

// The Mac app's platform; Phone.xcconfig sets the iPhone app's.
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
// macOS asks before the app reaches a server on the home network.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Usual Mail connects to your own mail server on your network.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Config/UsualMail-macOS.entitlements
ENABLE_HARDENED_RUNTIME = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
SWIFT_EMIT_LOC_STRINGS = YES

#include? "Local.xcconfig"
