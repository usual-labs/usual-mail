  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$description": "Geist Serif: the brief, headings and large text. One weight (Regular) and no italic: never ask it for bold or italic.",
        "$value": ["Geist Serif", "Georgia", "serif"]
      },
      "sans": {
        "$description": "Geist Sans: small text and controls.",
        "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
      },
      "mono": {
        "$description": "The system's monospace: ids, codes, booking references.",
        "$value": ["ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      },
      "wordmark": {
        "$description": "Prociono Regular, for the wordmark only. Never for text.",
        "$value": ["Prociono", "Georgia", "serif"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$description": "Geist Sans only.", "$value": 500 },
      "semibold": { "$description": "Geist Sans only: unread subjects and short emphasis.", "$value": 600 }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Text roles. Sizes are at the default text size: on the web they become rem, so they follow the reader's browser setting; on iPhone they grow with the text size setting like appleTextStyle; on the Mac they stay fixed.",
    "display": {
      "$description": "The brief's greeting and other single large lines.",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": { "value": 34, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": -0.34, "unit": "px" },
        "lineHeight": 1.15
      },
      "$extensions": {
        "dev.usual.mail": {
          "appleTextStyle": "largeTitle",
          "iphone": { "fontSize": { "value": 34, "unit": "px" } }
        }
      }
