{
  "$description": "Usual Mail's design tokens, the one source of truth for the web styles and the Swift values. Format: Design Tokens Format Module 2025.10. Each $value is the light (default) value. $extensions[\"dev.usual.mail\"] adds: dark (the value in dark appearance), reducedMotion (a duration when the reader asks for reduced motion), appleTextStyle (the iPhone text style a size grows with), and iphone (sizes that differ on iPhone). Generate with `npm run build` in design/.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The window behind everything.",
      "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9686, 0.9725], "hex": "#f6f7f8" },
      "$extensions": {
        "dev.usual.mail": {
          "dark": { "colorSpace": "srgb", "components": [0.0392, 0.0431, 0.051], "hex": "#0a0b0d" }
        }
      }
    },
    "surface": {
      "$description": "Cards, sheets and lists that sit on the background.",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
      "$extensions": {
        "dev.usual.mail": {
          "dark": { "colorSpace": "srgb", "components": [0.0706, 0.0784, 0.0902], "hex": "#121417" }
        }
      }
    },
    "sunken": {
