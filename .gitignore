# macOS
.DS_Store

# Node (node_modules/ also covers the root's, which holds only the Cloudflare tooling)
node_modules/
dist/
*.tsbuildinfo

# Cloudflare: wrangler's local state and bundles, local secrets for wrangler dev (.dev.vars and .dev.vars.<env>, but
